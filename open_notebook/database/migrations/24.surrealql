-- Flat collections; nullable assignments leave existing content Unfiled.
DEFINE TABLE folder SCHEMAFULL;
DEFINE FIELD name ON folder TYPE string ASSERT string::len(string::trim($value)) > 0 AND string::len($value) <= 100;
DEFINE FIELD kind ON folder TYPE string ASSERT $value IN ["notebook", "podcast"];
DEFINE FIELD folder_id ON notebook TYPE option<string>;
DEFINE FIELD folder_id ON episode TYPE option<string>;

-- Delete only the collection, never the content or generated audio.
DEFINE EVENT folder_delete ON folder WHEN $after == NONE THEN {
    UPDATE notebook SET folder_id = NONE WHERE folder_id = <string>$before.id;
    UPDATE episode SET folder_id = NONE WHERE folder_id = <string>$before.id;
};
